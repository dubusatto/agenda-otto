generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScheduledTask {
  id           String   @id @default(cuid())
  googleTaskId String
  title        String
  start        DateTime
  end          DateTime
  rrule        String?
  exdates      DateTime[]
  color        String?
  profile      String   @default("Trabalho")
  completed    Boolean  @default(false)
  hasCounter   Boolean  @default(false)
  userEmail    String
  
  instances    TaskInstance[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaskInstance {
  id              String   @id @default(cuid())
  scheduledTaskId String
  scheduledTask   ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)
  
  instanceDate    DateTime // Identifier for the specific date of this occurrence
  
  completed       Boolean  @default(false)
  completedAt     DateTime?
  count           Int      @default(0)
  
  timeEntries     TimeEntry[]
  
  @@unique([scheduledTaskId, instanceDate])
}

model TimeEntry {
  id              String   @id @default(cuid())
  taskInstanceId  String
  taskInstance    TaskInstance @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  
  startTime       DateTime
  endTime         DateTime?
  
  checkins        CheckIn[]
}

model CheckIn {
  id               String   @id @default(cuid())
  timeEntryId      String
  timeEntry        TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  
  note             String
  hasLunchDiscount Boolean  @default(false)
  timestamp        DateTime @default(now())
}

model Alarm {
  id            String    @id @default(cuid())
  title         String
  message       String?
  time          String    // Formato "HH:mm", ex: "17:30"
  color         String    @default("#ef4444")
  profile       String    @default("Trabalho")
  daysOfWeek    Int[]     // ex: [1, 2, 3, 4, 5] para Seg-Sex, vazio se data única
  date          DateTime? // para alarme de dia específico
  enabled       Boolean   @default(true)
  lastTriggered DateTime? // última vez que tocou
  snoozeUntil   DateTime? // se adiado, toca neste momento
  userEmail     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CalendarProfile {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("📌")
  color     String   @default("#3b82f6")
  userEmail String
  createdAt DateTime @default(now())

  @@unique([userEmail, name])
}

model CurriculumDocument {
  id             String                 @id @default(cuid())
  userEmail      String                 @unique
  content        String                 @db.Text
  previousBackup String?                @db.Text // Guarda a versão imediatamente anterior para permitir "Desfazer"
  lastAnalyzedAt DateTime?              // Cursor de timestamp do último CheckIn avaliado pela IA
  updatedAt      DateTime               @updatedAt
  createdAt      DateTime               @default(now())
  suggestions    CurriculumSuggestion[]
}

model CurriculumSuggestion {
  id             String             @id @default(cuid())
  curriculumId   String
  curriculum     CurriculumDocument @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  type           String             // "REWRITE" | "ADD"
  sectionTitle   String             // Título da seção no currículo onde a mudança ocorre
  originalText   String?            @db.Text // Preenchido em REWRITE (trecho exato atual no currículo)
  suggestedText  String             @db.Text // Novo texto proposto (para substituir originalText ou inserir na seção)
  reasoning      String             @db.Text // Por que essa entrega é relevante para vagas de Engenharia de Software
  sourceDates    String             // Ex: "03/11/2026"
  status         String             @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  createdAt      DateTime           @default(now())
  resolvedAt     DateTime?
}
