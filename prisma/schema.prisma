generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScheduledTask {
  id           String   @id @default(cuid())
  googleTaskId String
  title        String
  start        DateTime
  end          DateTime
  userEmail    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
