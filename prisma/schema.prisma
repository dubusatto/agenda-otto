generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScheduledTask {
  id           String   @id @default(cuid())
  googleTaskId String
  title        String
  start        DateTime
  end          DateTime
  rrule        String?
  exdates      DateTime[]
  color        String?
  completed    Boolean  @default(false)
  userEmail    String
  
  instances    TaskInstance[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaskInstance {
  id              String   @id @default(cuid())
  scheduledTaskId String
  scheduledTask   ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)
  
  instanceDate    DateTime // Identifier for the specific date of this occurrence
  
  completed       Boolean  @default(false)
  completedAt     DateTime?
  
  timeEntries     TimeEntry[]
  
  @@unique([scheduledTaskId, instanceDate])
}

model TimeEntry {
  id              String   @id @default(cuid())
  taskInstanceId  String
  taskInstance    TaskInstance @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  
  startTime       DateTime
  endTime         DateTime?
  
  checkins        CheckIn[]
}

model CheckIn {
  id               String   @id @default(cuid())
  timeEntryId      String
  timeEntry        TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  
  note             String
  hasLunchDiscount Boolean  @default(false)
  timestamp        DateTime @default(now())
}

model Alarm {
  id            String    @id @default(cuid())
  title         String
  message       String?
  time          String    // Formato "HH:mm", ex: "17:30"
  color         String    @default("#ef4444")
  daysOfWeek    Int[]     // ex: [1, 2, 3, 4, 5] para Seg-Sex, vazio se data única
  date          DateTime? // para alarme de dia específico
  enabled       Boolean   @default(true)
  lastTriggered DateTime? // última vez que tocou
  snoozeUntil   DateTime? // se adiado, toca neste momento
  userEmail     String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}
