generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ScheduledTask {
  id           String   @id @default(cuid())
  googleTaskId String
  title        String
  start        DateTime
  end          DateTime
  rrule        String?
  exdates      DateTime[]
  completed    Boolean  @default(false)
  userEmail    String
  
  instances    TaskInstance[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TaskInstance {
  id              String   @id @default(cuid())
  scheduledTaskId String
  scheduledTask   ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)
  
  instanceDate    DateTime // Identifier for the specific date of this occurrence
  
  completed       Boolean  @default(false)
  completedAt     DateTime?
  
  timeEntries     TimeEntry[]
  
  @@unique([scheduledTaskId, instanceDate])
}

model TimeEntry {
  id              String   @id @default(cuid())
  taskInstanceId  String
  taskInstance    TaskInstance @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  
  startTime       DateTime
  endTime         DateTime?
  
  checkins        CheckIn[]
}

model CheckIn {
  id          String   @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  
  note        String
  timestamp   DateTime @default(now())
}
